# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# NOTE: python-decouple does not strip inline comments, so every comment lives
# on its own line — a trailing "# ..." becomes part of the value.
# ---------------------------------------------------------------------------

### Core Django -------------------------------------------------------------
# dev | prod  (selects the settings module)
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

### Database ----------------------------------------------------------------
# Local dev: leave empty -> SQLite at ./db.sqlite3
# Render/Railway: set to the managed Postgres URL, e.g.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

### Auth / JWT --------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

### CORS --------------------------------------------------------------------
# Comma separated origins allowed to call the DRF API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=

### Celery / Redis ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# True => run tasks inline (no broker needed). Handy for tests / local demos.
CELERY_TASK_ALWAYS_EAGER=True

### AI microservice (consumed by Django) ------------------------------------
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=dev-internal-key-change-me
AI_SERVICE_TIMEOUT_SECONDS=10
AI_SERVICE_RETRIES=2
# Django-side throttle on the AI proxy endpoints: "<count>/<period>"
AI_RATE_LIMIT_PER_USER=20/hour

### Moderation policy -------------------------------------------------------
# auto_publish: publish immediately, record the verdict (default)
# hold_unsafe: hold unsafe posts for review instead of publishing
MODERATION_POLICY=auto_publish
# What to do when the AI service itself is down: fail_open | fail_closed
MODERATION_FAILURE_POLICY=fail_open

### Wellbeing nudge ---------------------------------------------------------
# N consecutive negative nightly checks before a nudge appears.
MOOD_NEGATIVE_STREAK_THRESHOLD=3
# Never nudge the same user more than once per N days.
NUDGE_COOLDOWN_DAYS=7

### Frontend ----------------------------------------------------------------
# Static/media roots (prod uses S3 or Render disks in a real deployment)
MEDIA_ROOT=
MEDIA_URL=/media/
