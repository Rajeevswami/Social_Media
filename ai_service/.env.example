# Copy to ai_service/.env — never commit the real file.
# NOTE: pydantic-settings ignores a `#` only when the line starts with one.
# Keep comments on their own line.

SERVICE_NAME=social-media-ai
# dev | staging | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Comma separated. Must match AI_SERVICE_API_KEY in the Django app's .env.
API_KEYS=dev-internal-key-change-me

CORS_ORIGINS=http://localhost:8000

# Rate limit per API key (sliding window)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TEXT_LENGTH=4000
MAX_MOOD_TEXTS=50

# Provider: openai | huggingface | heuristic
PROVIDER=heuristic
ALLOW_HEURISTIC_FALLBACK=True

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hugging Face Inference API
HF_API_TOKEN=
HF_MODERATION_MODEL=unitary/toxic-bert
HF_GENERATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Outbound HTTP
REQUEST_TIMEOUT_SECONDS=15
CONNECT_TIMEOUT_SECONDS=3
MAX_RETRIES=1

# Thresholds
TOXICITY_THRESHOLD=0.60
SPAM_THRESHOLD=0.70
